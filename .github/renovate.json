{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group all ASP.NET Core packages",
      "groupName": "ASP.NET Core",
      "matchPackageNames": [
        "/^Microsoft\\.AspNetCore/"
      ]
    },
    {
      "description": "Group all EF Core packages",
      "groupName": "Entity Framework Core",
      "matchPackageNames": [
        "/^Microsoft\\.EntityFrameworkCore/"
      ]
    },
    {
      "description": "Group all Azure SDK packages",
      "groupName": "Azure SDK",
      "matchPackageNames": [
        "/^Azure\\./",
        "/^Microsoft\\.Azure/"
      ]
    },
    {
      "description": "Group all xUnit packages",
      "groupName": "xUnit",
      "matchPackageNames": [
        "/^xunit/"
      ]
    },
    {
      "description": "Group all Moq packages",
      "groupName": "Moq",
      "matchPackageNames": [
        "/^Moq/"
      ]
    },
    {
      "description": "Group all Mediator packages",
      "groupName": "Mediator",
      "matchPackageNames": [
        "/^Mediator\\./"
      ]
    },
    {
      "description": "Group all Preact packages",
      "groupName": "Preact",
      "matchPackageNames": [
        "/^preact/"
      ]
    },
    {
      "description": "Group all Redux packages",
      "groupName": "Redux",
      "matchPackageNames": [
        "/^@reduxjs|^react-redux|^redux/"
      ]
    },
    {
      "description": "Group all Bulma packages",
      "groupName": "Bulma",
      "matchPackageNames": [
        "/^bulma|^react-bulma/"
      ]
    },
    {
      "description": "Group all ESLint packages",
      "groupName": "ESLint",
      "matchPackageNames": [
        "/^eslint|^@typescript-eslint/"
      ]
    },
    {
      "description": "Group all Jest packages",
      "groupName": "Jest",
      "matchPackageNames": [
        "/^jest|^@types/jest|^ts-jest/"
      ]
    },
    {
      "description": "Group all Microsoft Application Insights packages",
      "groupName": "Application Insights",
      "matchPackageNames": [
        "/^@microsoft/applicationinsights/"
      ]
    },
    {
      "description": "Group all SignalR packages",
      "groupName": "SignalR",
      "matchPackageNames": [
        "/^@microsoft/signalr/"
      ]
    },
    {
      "description": "Group all preact-cli related packages",
      "groupName": "preact-cli",
      "matchPackageNames": [
        "/^preact-cli|^preact-render/"
      ]
    },
    {
      "description": "Automerge minor and patch updates for dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Do not automerge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Group all React-related packages (Preact compat)",
      "groupName": "React/Preact compat",
      "matchPackageNames": [
        "/^react-|^@types/react/"
      ]
    }
  ],
  "postUpdateOptions": ["yarnDedupeHighest"],
  "rebaseWhen": "behind-base-branch",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "schedule": ["before 6am on Monday"],
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 10
}
