{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group all ASP.NET Core packages",
      "matchPackagePatterns": ["^Microsoft\\.AspNetCore"],
      "groupName": "ASP.NET Core"
    },
    {
      "description": "Group all EF Core packages",
      "matchPackagePatterns": ["^Microsoft\\.EntityFrameworkCore"],
      "groupName": "Entity Framework Core"
    },
    {
      "description": "Group all Azure SDK packages",
      "matchPackagePatterns": ["^Azure\\.", "^Microsoft\\.Azure"],
      "groupName": "Azure SDK"
    },
    {
      "description": "Group all xUnit packages",
      "matchPackagePatterns": ["^xunit"],
      "groupName": "xUnit"
    },
    {
      "description": "Group all Moq packages",
      "matchPackagePatterns": ["^Moq"],
      "groupName": "Moq"
    },
    {
      "description": "Group all Mediator packages",
      "matchPackagePatterns": ["^Mediator\\."],
      "groupName": "Mediator"
    },
    {
      "description": "Group all Preact packages",
      "matchPackagePatterns": ["^preact"],
      "groupName": "Preact"
    },
    {
      "description": "Group all Redux packages",
      "matchPackagePatterns": ["^@reduxjs|^react-redux|^redux"],
      "groupName": "Redux"
    },
    {
      "description": "Group all Bulma packages",
      "matchPackagePatterns": ["^bulma|^react-bulma"],
      "groupName": "Bulma"
    },
    {
      "description": "Group all ESLint packages",
      "matchPackagePatterns": ["^eslint|^@typescript-eslint"],
      "groupName": "ESLint"
    },
    {
      "description": "Group all Jest packages",
      "matchPackagePatterns": ["^jest|^@types/jest|^ts-jest"],
      "groupName": "Jest"
    },
    {
      "description": "Group all Microsoft Application Insights packages",
      "matchPackagePatterns": ["^@microsoft/applicationinsights"],
      "groupName": "Application Insights"
    },
    {
      "description": "Group all SignalR packages",
      "matchPackagePatterns": ["^@microsoft/signalr"],
      "groupName": "SignalR"
    },
    {
      "description": "Group all preact-cli related packages",
      "matchPackagePatterns": ["^preact-cli|^preact-render"],
      "groupName": "preact-cli"
    },
    {
      "description": "Automerge minor and patch updates for dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Do not automerge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Group all React-related packages (Preact compat)",
      "matchPackagePatterns": ["^react-|^@types/react"],
      "groupName": "React/Preact compat"
    }
  ],
  "postUpdateOptions": ["yarnDedupeHighest"],
  "rebaseWhen": "behind-base-branch",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "schedule": ["before 6am on Monday"],
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 10
}
