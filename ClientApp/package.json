    "@microsoft/signalr-protocol-msgpack": "10.0.11",
    "@react-oauth/google": "^0.13.0",
    "@reduxjs/toolkit": "2.12.0",
    "@s-libs/micro-dash": "21.1.0",
    "@types/react": "file:./src/types/fake-empty",
    "bulma": "1.0.4",
    "bulma-toast": "2.4.4",
    "javascript-time-ago": "^2.5.9",
    "preact": "10.29.8",
    "preact-router": "4.1.2",
    "pretty-bytes": "7.1.2",
    "promise-file-reader": "1.0.3",
    "react-bulma-components": "4.1.0",
    "react-icons": "5.7.0",
    "react-redux": "9.3.0",
    "react-timer-hook": "4.0.6",
    "redux-persist": "6.0.0",
    "save-file": "2.3.1",
